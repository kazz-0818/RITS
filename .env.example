# このファイルを .env にコピーし、各値を実キーに差し替えてください（.env は Git にコミットしない）

NODE_ENV=development
PORT=3000

OPENAI_API_KEY=ここにOpenAI APIキーを入れる
OPENAI_MODEL=gpt-4.1-mini

LINE_CHANNEL_ACCESS_TOKEN=ここにLINEチャネルアクセストークンを入れる
LINE_CHANNEL_SECRET=ここにLINEチャネルシークレットを入れる
LINE_OWNER_USER_ID=ここにオーナーのLINEユーザーIDを入れる（日次監査の push 先）
# 毎日 JST 09:00 にオーナーへ日次監査を push（LINE_OWNER_USER_ID があるとき既定で有効）
DAILY_OWNER_PUSH_TIME_JST=09:00
# false で自動 push を止める（手動 API は利用可）
DAILY_OWNER_PUSH_ENABLED=true

SUPABASE_URL=ここにSupabaseのProject URL（https://xxxx.supabase.co）を入れる
SUPABASE_SERVICE_ROLE_KEY=ここにSupabaseのservice_roleキーを入れる

ADMIN_API_KEY=ここに/admin API用の共有鍵を入れる
APP_BASE_URL=ここに公開URLを入れる（例: https://your-service.onrender.com）
