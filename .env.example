# =============================================================================
# Veriora 組織OS — 環境変数テンプレート（秘密は入れず .env にコピーして使用）
# 命名規約: docs/env-conventions.md
# 新規キーは VERIORA_* または RITS_* を推奨（Phase 3 で既存名との alias 予定）
# 既存キー名は後方互換のため削除しないでください。
# =============================================================================

NODE_ENV=development
PORT=3000

OPENAI_API_KEY=
OPENAI_MODEL=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OWNER_USER_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_API_KEY=
APP_BASE_URL=
